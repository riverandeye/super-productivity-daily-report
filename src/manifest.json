{
  "id": "daily-report",
  "name": "Daily Report",
  "manifestVersion": 1,
  "version": "1.3.0",
  "minSupVersion": "20.0.0",
  "description": "A monthly calendar of the tasks and subtasks you checked off each day, plus what is planned. Click a day to see the list and check off planned items.",
  "author": "riverandeye",
  "homepage": "https://github.com/riverandeye/super-productivity-daily-report",
  "hooks": [],
  "permissions": [
    "getTasks",
    "getArchivedTasks",
    "getAllProjects",
    "updateTask",
    "showIndexHtmlAsView"
  ],
  "dataSharing": [],
  "i18n": {
    "languages": [
      "en",
      "ko"
    ]
  },
  "iFrame": true,
  "sidePanel": false,
  "type": "standard",
  "assets": [],
  "icon": "icon.svg"
}
