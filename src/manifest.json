{
  "id": "daily-report",
  "name": "Daily Report",
  "manifestVersion": 1,
  "version": "1.2.0",
  "minSupVersion": "20.0.0",
  "description": "A monthly calendar of the tasks and subtasks you checked off each day. Click a day to see what you finished, shown as project › task › subtask.",
  "author": "riverandeye",
  "homepage": "https://github.com/riverandeye/super-productivity-daily-report",
  "hooks": [],
  "permissions": [
    "getTasks",
    "getArchivedTasks",
    "getAllProjects",
    "showIndexHtmlAsView"
  ],
  "dataSharing": [],
  "i18n": {
    "languages": ["en", "ko"]
  },
  "iFrame": true,
  "sidePanel": false,
  "type": "standard",
  "assets": [],
  "icon": "icon.svg"
}
